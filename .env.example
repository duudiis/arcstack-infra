DB_PASSWORD=arcstack_dev
REDIS_PASSWORD=arcstack_dev
JWT_SECRET=change-me-jwt-secret-minimum-32-chars!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
OPENAI_API_KEY=sk-your-openai-api-key

# AWS EC2 provisioning
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_AMI_ID=ami-0abcdef1234567890
AWS_SECURITY_GROUP_ID=sg-0abcdef1234567890
AWS_SUBNET_ID=subnet-0abcdef1234567890
AWS_KEY_PAIR_NAME=arcstack-key
AWS_INSTANCE_TYPE=t2.micro

# Agent connectivity — the URL agents on EC2 connect back to
AGENT_WS_URL=wss://api.arcstack.dudis.space
AGENT_REPO_URL=https://github.com/duudiis/arcstack-agent.git

